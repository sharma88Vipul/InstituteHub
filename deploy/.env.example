# Copy to deploy/.env and fill in. Never commit .env (it is in .gitignore).

# Public address of the app; DNS A record must point to this server.
APP_DOMAIN=app.example.in
# Image built by CI (GitHub Container Registry) or locally with "docker compose build".
APP_IMAGE=ghcr.io/your-github-user/institutehub:latest

# Database password (long and random: openssl rand -base64 24)
POSTGRES_PASSWORD=change-me

# Seq log UI admin password (first start only)
SEQ_ADMIN_PASSWORD=change-me

# Platform admin account created on first start
Seed__PlatformAdminEmail=you@example.com
Seed__PlatformAdminPassword=change-me-Strong#1

# Messaging (only Fake until a WhatsApp/SMS provider is connected)
Messaging__Provider=Fake
Messaging__ApiKey=
Messaging__WebhookSecret=

# Apply EF migrations when the app starts (simple single-server setup). Set to false if you run the bundle instead.
Database__MigrateOnStartup=true

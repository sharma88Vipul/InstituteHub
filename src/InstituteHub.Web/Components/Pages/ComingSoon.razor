@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject NavigationManager Navigation

@* Placeholder for modules scheduled in later weeks (design doc section 8). Each route moves to
   its own page under Features/ as the module is built. *@

<PageTitle>Coming soon – InstituteHub</PageTitle>

<MudPaper Class="pa-6 mt-2" Outlined="true">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Construction" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h6">@_title is coming soon</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center">@_when</MudText>
        <MudButton Href="dashboard" Variant="Variant.Text" Color="Color.Primary">Back to dashboard</MudButton>
    </MudStack>
</MudPaper>

@code {
    private string _title = "";
    private string _when = "";

    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        (_title, _when) = path switch
        {
            "admin" => ("Platform admin", "Listing institutes, extending trials and plan changes come after the pilot. Use the Background jobs dashboard meanwhile."),
            _ => ("This page", "It is on the build plan."),
        };
    }
}

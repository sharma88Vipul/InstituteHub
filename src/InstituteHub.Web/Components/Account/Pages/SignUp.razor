@page "/signup"

@using System.ComponentModel.DataAnnotations
@using InstituteHub.Application.Tenants
@using InstituteHub.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity

@inject ISignUpService SignUpService
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<SignUp> Logger

<PageTitle>Sign up your institute</PageTitle>

<h1 class="h3 mb-1">Start your free trial</h1>
<p class="text-muted mb-4">14 days free. No card needed. Set up in under 5 minutes.</p>

<AuthorizeView>
    <Authorized>
        <div class="alert alert-info">
            You are already signed in as <strong>@context.User.Identity?.Name</strong>.
            <a href="dashboard">Go to your dashboard</a> or log out to register a different institute.
        </div>
    </Authorized>
    <NotAuthorized>
        <StatusMessage Message="@message" />
        <EditForm Model="Input" method="post" OnValidSubmit="SignUpUser" FormName="signup" Context="formContext">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.InstituteName" id="Input.InstituteName" class="form-control" autocomplete="organization" placeholder="Institute name" />
                <label for="Input.InstituteName">Institute name</label>
                <ValidationMessage For="() => Input.InstituteName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.OwnerName" id="Input.OwnerName" class="form-control" autocomplete="name" placeholder="Your name" />
                <label for="Input.OwnerName">Your name</label>
                <ValidationMessage For="() => Input.OwnerName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Phone" id="Input.Phone" type="tel" class="form-control" autocomplete="tel" placeholder="98765 43210" />
                <label for="Input.Phone">Mobile number</label>
                <ValidationMessage For="() => Input.Phone" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" type="email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label for="Input.Email">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Password" id="Input.Password" type="password" class="form-control" autocomplete="new-password" placeholder="Password" />
                <label for="Input.Password">Password</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                <label for="Input.ConfirmPassword">Confirm password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Create my institute</button>
        </EditForm>

        <p class="mt-3 text-center">Already have an account? <a href="Account/Login">Log in</a></p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task SignUpUser(EditContext editContext)
    {
        var request = new SignUpRequest(Input.InstituteName, Input.OwnerName, Input.Phone, Input.Email, Input.Password);
        var result = await SignUpService.SignUpAsync(request, CancellationToken.None);

        if (result.IsFailure)
        {
            message = "Error: " + string.Join(" ", result.Errors.Select(e => e.Message));
            return;
        }

        var user = await UserManager.FindByIdAsync(result.Value.UserId.ToString());
        if (user is null)
        {
            Logger.LogError("Signed-up user {UserId} could not be loaded", result.Value.UserId);
            message = "Error: Your institute was created but we could not sign you in. Please log in.";
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        RedirectManager.RedirectTo("onboarding");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your institute's name.")]
        [StringLength(150)]
        public string InstituteName { get; set; } = "";

        [Required(ErrorMessage = "Enter your name.")]
        [StringLength(120)]
        public string OwnerName { get; set; } = "";

        [Required(ErrorMessage = "Enter your mobile number.")]
        public string Phone { get; set; } = "";

        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Choose a password.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Your password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

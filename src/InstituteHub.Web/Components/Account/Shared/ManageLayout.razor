@inherits LayoutComponentBase
@layout InstituteHub.Web.Components.Layout.MainLayout

@* Account settings (/Account/Manage/*). The pages come from the Identity template and use Bootstrap markup;
   ManageLayout.razor.css restyles them to match the MudBlazor look of the rest of the app. *@

<div class="account-page">
    <div class="account-header">
        <h1 class="account-title">My account</h1>
        <p class="account-subtitle">Your profile, sign-in and privacy settings.</p>
    </div>

    <div class="account-grid">
        <nav class="account-nav" aria-label="Account settings">
            <ManageNavMenu />
        </nav>
        <section class="account-content">
            @Body
        </section>
    </div>
</div>
